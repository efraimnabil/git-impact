{
  "name": "git-impact",
  "version": "0.7.1",
  "description": "Translate your git commits into plain-English business impact — runs inside your AI editor, no API key.",
  "author": "Efraim Nafady",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/efraimnafady/git-impact"
  },
  "homepage": "https://github.com/efraimnafady/git-impact#readme",
  "main": "dist/cli/index.js",
  "bin": {
    "git-impact": "dist/cli/index.js",
    "git-impact-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist/",
    "skill/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "ts-node src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "mcp": "node dist/mcp/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "git",
    "standup",
    "productivity",
    "ai",
    "mcp",
    "claude",
    "developer-tools"
  ],
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.3",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
